---
import { nav, services } from '../data/site';
import { assetUrl, pageUrl, withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  section?: string;
  /** Imaginea pentru distribuire (cale relativă la public/ sau URL absolut). */
  image?: string;
  ogType?: 'website' | 'article';
  /** Date structurate în plus față de cele ale firmei (de exemplu un Article). */
  jsonLd?: Record<string, unknown>;
}

const { title, description, section = '', image, ogType = 'website', jsonLd } = Astro.props;
const home = withBase();
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHere = (href: string) => (href.replace(/\/$/, '') || '/') === here;

// Doar domeniul final se indexează; previzualizarea rămâne ascunsă de motoarele de căutare.
const indexable = Astro.site?.hostname === 'fiscontsrl.ro';
const canonical = pageUrl(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  image && /^https?:/.test(image) ? image : assetUrl(image ?? 'assets/hero.jpg'),
  Astro.site,
).href;
const homeUrl = new URL(home, Astro.site).href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': `${homeUrl}#firma`,
  name: 'Fiscont',
  legalName: 'Fiscont Expert Consulting Solution SRL',
  url: homeUrl,
  logo: new URL(assetUrl('assets/logo-fiscont.png'), Astro.site).href,
  image: new URL(assetUrl('assets/hero.jpg'), Astro.site).href,
  telephone: '+40759011054',
  email: 'office@fiscontsrl.ro',
  foundingDate: '2012',
  taxID: '30138979',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Bd. Unirii nr. 64, Bloc K4, scara 4, etaj 3',
    addressLocality: 'București',
    addressCountry: 'RO',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '18:00',
  },
  sameAs: ['https://fiscontprint.ro/', 'https://tcasafework.ro/'],
};
const structured = jsonLd ? [business, jsonLd] : business;
---

<!doctype html>
<html lang="ro" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? null : <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="Fiscont" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={assetUrl('sitemap-index.xml')} />
    <link rel="stylesheet" href={assetUrl('assets/fonts.css')} />
    <link rel="stylesheet" href={assetUrl('assets/styles.css')} />
    <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
    <link rel="icon" href={assetUrl('assets/favicon-64.png')} type="image/png" />
    <link rel="apple-touch-icon" href={assetUrl('assets/apple-touch-icon.png')} />
    <script is:inline>
      document.documentElement.className = "js";
    </script>
  </head>
  <body>
    <a class="skip" href="#continut">Sari la conținut</a>

    <header class="site-head">
      <div class="wrap">
        <a class="wordmark" href={home} aria-label="Fiscont, contabilitate dincolo de cifre. Pagina de acasă">
          <img class="logo" src={assetUrl('assets/logo-fiscont.png')} width="180" height="47" alt="" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav">Meniu</button>
        <nav class="nav" id="nav" aria-label="Principal">
          <ul>
            {
              nav.map(({ key, href, label }) => (
                <li class:list={[{ 'has-sub': key === 'servicii' }]}>
                  <a
                    href={withBase(href)}
                    aria-current={key === section ? 'page' : undefined}
                    aria-haspopup={key === 'servicii' ? 'true' : undefined}
                  >
                    {label}
                  </a>
                  {
                    key === 'servicii' && (
                      <ul class="sub" aria-label="Servicii de contabilitate">
                        {
                          services.map((s) => {
                            const href = withBase(`servicii/${s.slug}`);
                            return (
                              <li>
                                <a href={href} aria-current={isHere(href) ? 'page' : undefined}>
                                  {s.title}
                                </a>
                              </li>
                            );
                          })
                        }
                      </ul>
                    )
                  }
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="continut">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <img
              class="logo"
              src={assetUrl('assets/logo-fiscont.png')}
              width="150"
              height="39"
              alt="Fiscont, contabilitate dincolo de cifre"
            />
            <p>
              Fiscont Expert Consulting Solution SRL<br />
              CUI 30138979<br />
              Nr. Reg. Com. J2012001192237<br />
              Sediu social: Str. Smîrdan nr. 30, Bragadiru, jud. Ilfov<br />
              Membru CECCAR, autorizația nr. 8032
            </p>
          </div>
          <div>
            <h2>Birou</h2>
            <p>
              Bd. Unirii nr. 64, Bloc K4,<br />
              scara 4, etaj 3, București<br />
              Luni–vineri, 9:00–18:00
            </p>
          </div>
          <div>
            <h2>Contact</h2>
            <ul>
              <li><a href="tel:+40759011054">+40 759 011 054</a></li>
              <li><a href="mailto:office@fiscontsrl.ro">office@fiscontsrl.ro</a></li>
              <li>
                <a href={`${withBase('contact')}#programare`}>Programează o discuție</a>
              </li>
            </ul>
          </div>
          <div>
            <h2>Informații</h2>
            <ul>
              <li><a href={withBase('servicii')}>Servicii</a></li>
              <li>
                <a href="https://fiscontprint.ro/" target="_blank" rel="noopener noreferrer">Fiscont Proiecte</a>
              </li>
              <li>
                <a href="https://tcasafework.ro/" target="_blank" rel="noopener noreferrer">TCA SAFEWORK</a>
              </li>
              <li>
                <a href={withBase('confidentialitate')}>Confidențialitate și cookie-uri</a>
              </li>
              <li>
                <a href="https://ceccar.ro/ro/?page_id=97">Verificare membri CECCAR</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="foot-meta">
          <span>© 2012–{new Date().getFullYear()} Fiscont Expert Consulting Solution SRL</span>
        </div>
      </div>
    </footer>

    <script src={assetUrl('assets/site.js')} defer></script>
  </body>
</html>
