---
import Base from '../layouts/Base.astro';
import TeamLedger from '../components/TeamLedger.astro';
import { services, homeTeam, proiecte, ssm, reviews, googleReviewsUrl, industries } from '../data/site';
import { assetUrl, withBase } from '../utils/paths';
---

<Base
  title="Fiscont | Contabilitate dincolo de cifre, București"
  description="Fiscont Expert Consulting Solution: contabilitate, consultanță financiară și resurse umane pentru antreprenori. Membru CECCAR, activă din 2012, București."
>
  <section class="hero hero-photo" aria-labelledby="titlu">
    <picture class="hero-media" aria-hidden="true">
      <source srcset={assetUrl('assets/hero.webp')} type="image/webp" />
      <img
        src={assetUrl('assets/hero.jpg')}
        alt=""
        width="1920"
        height="1080"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="wrap">
      <div class="hero-simple">
        <h1 id="titlu">Contabilitate dincolo de cifre.</h1>
        <p class="hero-kicker">
          Partenerul tău de încredere pentru claritate financiară și creștere sustenabilă.
        </p>
        <p class="lead">
          Transformăm rigoarea contabilă și fiscală în decizii inteligente de business. Îți oferim
          claritatea, controlul și libertatea de care ai nevoie pentru o dezvoltare sigură și
          sustenabilă.
        </p>
        <div class="actions">
          <a class="btn" href={`${withBase('contact')}#programare`}>Programează o discuție</a>
          <a href={`${withBase('despre')}#echipa`}>Cunoaște echipa</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ecosistem">
    <div class="wrap">
      <div class="sec-head eco-head">
        <h2 id="ecosistem">Ecosistemul Fiscont</h2>
        <div>
          <p>
            <strong>Contabilitate | CFO | HR | SSM &amp; PSI:</strong> expertiză integrată și
            soluții conectate pentru mai multă claritate și predictibilitate în afacerea ta.
          </p>
          <p>
            O afacere sustenabilă are nevoie de claritate financiară, decizii bine fundamentate și
            procese care funcționează împreună.
          </p>
        </div>
      </div>

      <div class="eco">
        <div class="eco-layer">
          <p class="eco-label">Evidență</p>
          <h3>Fiscont Contabilitate</h3>
          <p class="eco-lead">
            <strong>Claritate în cifre. Control în activitatea de zi cu zi.</strong>
            Servicii contabile și administrative care te ajută să ții evidența corectă a afacerii
            și să ai informațiile necesare pentru a o gestiona.
          </p>
          <ul class="eco-list">
            {
              services.map((s) => (
                <li>
                  <a href={withBase(`servicii/${s.slug}`)}>{s.title}</a>
                </li>
              ))
            }
          </ul>
          <p class="actions">
            <a href={withBase('servicii')}>Descoperă serviciile Fiscont</a>
          </p>
        </div>

        <div class="eco-layer eco-proiecte">
          <p class="eco-label">Decizie</p>
          <h3>{proiecte.title}</h3>
          <p class="eco-lead">Cifrele transformate în direcție: CFO, audit, reorganizare.</p>
          <ul class="eco-list">
            {
              proiecte.items.map((item) => (
                <li>
                  <span class="eco-item-title">{item.title}</span>
                </li>
              ))
            }
          </ul>
          <p class="actions">
            <a class="btn" href={proiecte.url} target="_blank" rel="noopener noreferrer">
              Fiscont Proiecte
            </a>
          </p>
        </div>

        <div class="eco-layer">
          <p class="eco-label">Conformitate</p>
          <h3>{ssm.title}</h3>
          <p class="eco-lead">SSM și PSI / SU: un abonament, un contract, un om de contact.</p>
          <ul class="eco-list">
            {
              ssm.items.map((item) => (
                <li>
                  <span class="eco-item-title">{item.title}</span>
                </li>
              ))
            }
          </ul>
          <p class="actions">
            <a class="btn btn-line" href={ssm.url} target="_blank" rel="noopener noreferrer">
              TCA SAFEWORK
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="team on-blue" aria-labelledby="echipa">
    <div class="wrap">
      <div class="sec-head team-intro">
        <h2 id="echipa" class="script">Descoperă oamenii din spatele cifrelor.</h2>
        <p>
          <strong>O echipă de experți. Un parteneriat construit pe încredere și peste 10 ani de experiență.</strong>
          În spatele fiecărei afaceri bine gestionate stau oameni care înțeleg cifrele, anticipează
          provocările și găsesc soluții. La Fiscont, îmbinăm expertiza contabilă și fiscală cu
          atenția față de fiecare client, pentru ca tu să ai claritate, siguranță și sprijin în
          deciziile care contează.
        </p>
      </div>
      <TeamLedger label="Echipa Fiscont" members={homeTeam} bios={true} lastCol="Pe scurt" />
      <p class="actions"><a href={withBase('despre')}>Află mai multe despre noi</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="incredere">
    <div class="wrap">
      <div class="reviews-head">
        <h2 id="incredere">Ce spun clienții noștri</h2>
        <a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">Recenziile pe Google</a>
      </div>
      <div class="quote-marquee" data-quote-marquee>
        <button type="button" class="quote-arrow prev" data-quote-prev aria-label="Recenzia anterioară"></button>
        <button type="button" class="quote-arrow next" data-quote-next aria-label="Recenzia următoare"></button>
        <div class="quote-window">
        <div class="quote-track">
          {
            reviews.map((review) => (
              <figure class="quote">
                <blockquote>
                  <q>{review.quote}</q>
                </blockquote>
                <figcaption>
                  <b>{review.author}</b>
                  <span class="muted small">client Fiscont</span>
                </figcaption>
              </figure>
            ))
          }
          {
            reviews.map((review) => (
              <figure class="quote" data-clone aria-hidden="true">
                <blockquote>
                  <q>{review.quote}</q>
                </blockquote>
                <figcaption>
                  <b>{review.author}</b>
                  <span class="muted small">client Fiscont</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        </div>
      </div>
      <div class="talk-cta">
        <h2>Să vorbim despre firma ta</h2>
        <p class="lead" style="margin-top:var(--sp-2)">
          Prima discuție e despre situația ta. Alege o oră care ți se potrivește sau sună-ne.
        </p>
        <div class="actions">
          <a class="btn" href={`${withBase('contact')}#programare`}>Programează o discuție</a>
          <a href="tel:+40759011054">+40 759 011 054</a>
        </div>
        <dl class="ledger kv" style="margin-top:var(--sp-4)">
          <div class="r">
            <dt>E-mail</dt>
            <dd><a href="mailto:office@fiscontsrl.ro">office@fiscontsrl.ro</a></dd>
          </div>
          <div class="r"><dt>Program</dt><dd>Luni–vineri, 9:00–18:00</dd></div>
          <div class="r">
            <dt>Birou</dt>
            <dd>Bd. Unirii nr. 64, Bloc K4, scara 4, etaj 3, București</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="industrii">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="industrii">Industrii</h2>
        <p>
          Soluții contabile adaptate pentru orice industrie. Avem experiență în diverse domenii, de
          la agricultură, servicii și comerț, până la transporturi, birouri notariale și cabinete
          medicale. Indiferent de sectorul tău de activitate, echipa noastră de experți te ajută să
          îndeplinești toate reglementările fiscale, oferindu-ți siguranță și conformitate.
        </p>
      </div>
      <div class="logo-marquee">
        <ul class="logo-track">
          {
            industries.map((logo) => (
              <li>
                <img
                  src={assetUrl(`assets/clienti/${logo.file}`)}
                  alt={logo.name}
                  width="118"
                  height="118"
                  loading="lazy"
                />
              </li>
            ))
          }
          {
            industries.map((logo) => (
              <li data-clone aria-hidden="true">
                <img
                  src={assetUrl(`assets/clienti/${logo.file}`)}
                  alt=""
                  width="118"
                  height="118"
                  loading="lazy"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>
