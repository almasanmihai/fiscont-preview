---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { services, proiecte, ssm } from '../../data/site';
import { withBase } from '../../utils/paths';
---

<Base
  title="Servicii | Fiscont"
  description="Contabilitate, consultanță, HR, juridic, Fiscont Proiecte și TCA SAFEWORK (SSM / PSI). Ecosistemul Fiscont, București."
  section="servicii"
>
  <PageHead
    crumb="Servicii"
    h1="Servicii"
    lead="Ecosistemul Fiscont: evidență, decizie și conformitate. Prețurile se discută la o întâlnire, în funcție de firma ta."
  />

  <section class="section" aria-labelledby="eco-servicii">
    <div class="wrap">
      <h2 id="eco-servicii" class="sr">Ecosistemul de servicii</h2>
      <div class="eco">
        <div class="eco-layer">
          <p class="eco-label">Evidență</p>
          <h3>Fiscont</h3>
          <p class="eco-lead">Ce s-a întâmplat: contabilitate, HR și juridic.</p>
          <ul class="eco-list">
            {
              services.map((s) => (
                <li>
                  <a href={withBase(`servicii/${s.slug}`)}>{s.title}</a>
                  <span>{s.summary}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="eco-layer eco-proiecte">
          <p class="eco-label">Decizie</p>
          <h3>{proiecte.title}</h3>
          <p class="eco-lead">{proiecte.lead}</p>
          <ul class="eco-list">
            {
              proiecte.items.map((item) => (
                <li>
                  <span class="eco-item-title">{item.title}</span>
                  <span>{item.summary}</span>
                </li>
              ))
            }
          </ul>
          <p class="actions">
            <a class="btn" href={proiecte.url} rel="noopener noreferrer">
              Fiscont Proiecte
            </a>
          </p>
        </div>

        <div class="eco-layer">
          <p class="eco-label">Conformitate</p>
          <h3>{ssm.title}</h3>
          <p class="eco-lead">{ssm.lead}</p>
          <ul class="eco-list">
            {
              ssm.items.map((item) => (
                <li>
                  <span class="eco-item-title">{item.title}</span>
                  <span>{item.summary}</span>
                </li>
              ))
            }
          </ul>
          <p class="actions">
            <a class="btn btn-line" href={ssm.url} rel="noopener noreferrer">
              TCA SAFEWORK
            </a>
          </p>
        </div>
      </div>

      <div class="actions" style="margin-top:var(--sp-4)">
        <a class="btn" href={`${withBase('contact')}#programare`}>Programează o discuție</a>
      </div>
    </div>
  </section>
</Base>
