---
import Base from '../../layouts/Base.astro';
import PostRows from '../../components/PostRows.astro';
import { categories } from '../../content.config';
import { team } from '../../data/site';
import { getCollection, render } from 'astro:content';
import { assetUrl, pageUrl, withBase } from '../../utils/paths';

export async function getStaticPaths() {
  // Ciornele nu primesc pagină: altfel ar fi accesibile direct prin URL.
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const cat = post.data.category;
const member = team.find((m) => m.name === post.data.author);
const photo = member?.photo ?? null;
const authorRole = post.data.authorRole.trim();
const body = post.body ?? '';
const firstImage = body.match(/!\[[^\]]*\]\((\/uploads\/[^)\s]+)/)?.[1];
const words = body
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/[#>*_`[\]()-]/g, ' ')
  .trim()
  .split(/\s+/).length;
const readingMins = Math.max(1, Math.round(words / 200));
const fmt = new Intl.DateTimeFormat('ro-RO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description || undefined,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'ro',
  author: { '@type': 'Person', name: post.data.author, jobTitle: post.data.authorRole },
  publisher: { '@id': `${new URL(withBase(), Astro.site).href}#firma` },
  mainEntityOfPage: pageUrl(Astro.url.pathname, Astro.site),
  image: firstImage ? new URL(withBase(firstImage), Astro.site).href : undefined,
};
---

<Base
  title={`${post.data.title} | Blog Fiscont`}
  description={post.data.description || post.data.title}
  section="blog"
  image={firstImage}
  ogType="article"
  jsonLd={article}
>
  <article>
    <header class="article-head">
      <div class="wrap">
        <p class="small muted">
          <a class="muted" href={withBase()}>Acasă</a> /{' '}
          <a class="muted" href={withBase('blog')}>Blog</a> / {categories[cat]}
        </p>
        <h1 style="margin-top:1rem">{post.data.title}</h1>
        {
          post.data.description ? (
            <p class="deck">{post.data.description}</p>
          ) : null
        }
        <div class="byline">
          <div class="who">
            {
              photo ? (
                <span class="photo on-paper">
                  <img
                    src={assetUrl(`assets/echipa/${photo}`)}
                    width="360"
                    height="360"
                    alt={post.data.author}
                    loading="lazy"
                  />
                </span>
              ) : null
            }
            <div>
              <b>{post.data.author}</b>
              <span class="small muted">{post.data.authorRole}</span>
            </div>
          </div>
          <dl>
            <div>
              <dt>Publicat</dt>
              <dd>
                <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
              </dd>
            </div>
            <div>
              <dt>Citire</dt>
              <dd>{readingMins} min</dd>
            </div>
            <div>
              <dt>Categorie</dt>
              <dd>{categories[cat]}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <div class="wrap body-grid article-body">
      <div class="prose">
        <Content />
      </div>
    </div>

    <div class="wrap" style="padding-bottom:var(--sp-5)">
      <section class="author" aria-label="Despre autor">
        {
          photo ? (
            <span class="photo on-paper lg">
              <img
                src={assetUrl(`assets/echipa/${photo}`)}
                width="360"
                height="360"
                alt={post.data.author}
                loading="lazy"
              />
            </span>
          ) : null
        }
        <div>
          <h2 style="font-size:1.25rem">{post.data.author}</h2>
          <p class="muted small" style="margin-top:.2rem">
            {/fiscont/i.test(authorRole) ? authorRole : `${authorRole}, Fiscont`}
          </p>
          {member ? <p style="margin-top:.8rem;max-width:60ch">{member.bio}</p> : null}
        </div>
      </section>
      <p class="disclaimer">
        Articolele au caracter informativ și nu înlocuiesc consultanța pentru situația concretă a
        firmei tale. Legislația se schimbă; verifică data publicării sau întreabă-ne.
      </p>

      <section style="margin-top:var(--sp-5)" aria-labelledby="similare">
        <h2 id="similare" style="font-size:1.3rem;margin-bottom:1rem">Alte articole</h2>
        <div class="ledger posts" role="table" aria-label="Alte articole">
          <div class="r head" role="row">
            <span role="columnheader">Data</span>
            <span role="columnheader">Articol</span>
            <span role="columnheader">Categorie</span>
          </div>
          <PostRows limit={2} withExcerpt={false} exclude={post.id} />
        </div>
      </section>
    </div>
  </article>
</Base>
