---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostRows from '../../components/PostRows.astro';
import { categories } from '../../content.config';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const count = posts.length;
// Filtrele apar doar pentru categoriile care au articole; celelalte rămân în schemă pentru mai târziu.
const used = new Set(posts.map((p) => p.data.category));
const shownCategories = Object.entries(categories).filter(([k]) => used.has(k as keyof typeof categories));
---

<Base
  title="Blog | Fiscont"
  description="Idei practice, explicații fiscale, perspective despre leadership și inspirație pentru decizii mai bune."
  section="blog"
>
  <PageHead
    crumb="Blog"
    h1="Blog"
    lead="Idei practice, explicații fiscale, perspective despre leadership și inspirație pentru decizii mai bune. Descoperă idei care te ajută să-ți înțelegi afacerea, să-ți conduci echipa și să crești sustenabil."
  />

  <section class="section">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filtrează după categorie">
        <button type="button" data-filter="toate" aria-pressed="true">Toate</button>
        {
          shownCategories.map(([k, v]) => (
            <button type="button" data-filter={k} aria-pressed="false">
              {v}
            </button>
          ))
        }
      </div>
      <p id="filter-status" class="small muted" aria-live="polite" style="margin-bottom:1rem">
        {count} articole
      </p>

      <div class="ledger posts" role="table" aria-label="Articole">
        <div class="r head" role="row">
          <span role="columnheader">Data</span>
          <span role="columnheader">Articol</span>
          <span role="columnheader">Categorie</span>
        </div>
        <PostRows />
      </div>
    </div>
  </section>
</Base>
